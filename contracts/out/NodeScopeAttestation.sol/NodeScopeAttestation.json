:{\"abi\":[{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"bytes32\",\"name\":\"reportHash\",\"type\":\"bytes32\"},{\"indexed\":true,\"internalType\":\"address\",\"name\":\"anchorer\",\"type\":\"address\"},{\"indexed\":false,\"internalType\":\"string\",\"name\":\"endpoint\",\"type\":\"string\"},{\"indexed\":false,\"internalType\":\"uint256\",\"name\":\"chainId\",\"type\":\"uint256\"},{\"indexed\":false,\"internalType\":\"uint256\",\"name\":\"blockNumber\",\"type\":\"uint256\"},{\"indexed\":false,\"internalType\":\"uint256\",\"name\":\"timestamp\",\"type\":\"uint256\"}],\"name\":\"Attested\",\"type\":\"event\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"reportHash\",\"type\":\"bytes32\"},{\"internalType\":\"string\",\"name\":\"endpoint\",\"type\":\"string\"},{\"internalType\":\"uint256\",\"name\":\"chainId\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"blockNumber\",\"type\":\"uint256\"}],\"name\":\"anchor\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"\",\"type\":\"bytes32\"}],\"name\":\"anchored\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"\",\"type\":\"bytes32\"}],\"name\":\"anchorerOf\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"reportHash\",\"type\":\"bytes32\"}],\"name\":\"isAnchored\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"view\",\"type\":\"function\"}],\"devdoc\":{\"details\":\"No owner, no upgrade, no fees, no token. Anyone may anchor any report hash once. Anchoring twice is rejected so one hash maps to one first anchor. The contract is testnet-only by deployment choice, not by code: deploy it only on a testnet, with a throwaway testnet wallet.\",\"kind\":\"dev\",\"methods\":{},\"title\":\"NodeScopeAttestation\",\"version\":1},\"userdoc\":{\"events\":{\"Attested(bytes32,address,string,uint256,uint256,uint256)\":{\"notice\":\"Emitted when a report hash is anchored for the first time.\"}},\"kind\":\"user\",\"methods\":{\"anchor(bytes32,string,uint256,uint256)\":{\"notice\":\"Anchor a report hash. Reverts on an empty hash or a second anchor of the same hash.\"},\"anchored(bytes32)\":{\"notice\":\"True once a report hash has been anchored.\"},\"anchorerOf(bytes32)\":{\"notice\":\"The address that first anchored a report hash.\"},\"isAnchored(bytes32)\":{\"notice\":\"Read-only check: has this report hash been anchored?\"}},\"notice\":\"A minimal, ownerless registry that anchors a NodeScope diagnostic report's SHA-256 integrity hash on chain. It proves that a report with this hash existed at the time of the anchoring transaction, and nothing more. It does not prove that the node data inside the report was true: that is what the report's own records, timestamps, and the /verify check are for.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"contracts/NodeScopeAttestation.sol\":\"NodeScopeAttestation\"},\"evmVersion\":\"cancun\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\":forge-std/=lib/forge-std/src/\"]},\"sources\":{\"contracts/NodeScopeAttestation.sol\":{\"keccak256\":\"0xf715f02c3485fd727111e1a8832d6b7717334f91f387ad6880f57a2148093775\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://fcfe3f1c47bac79b85f0c767ee24ff016ec73a9d38a3e2c76e1a59bc0af2928c\",\"dweb:/ipfs/QmVrKfhA7HJLXWz1W2nA46Wc7j7nE6aSujnfu4Biqiz4ov\"]}},\"version\":1}","metadata":{"compiler":{"version":"0.8.24+commit.e11b9ed9"},"language":"Solidity","output":{"abi":[{"inputs":[{"internalType":"bytes32","name":"reportHash","type":"bytes32","indexed":true},{"internalType":"address","name":"anchorer","type":"address","indexed":true},{"internalType":"string","name":"endpoint","type":"string","indexed":false},{"internalType":"uint256","name":"chainId","type":"uint256","indexed":false},{"internalType":"uint256","name":"blockNumber","type":"uint256","indexed":false},{"internalType":"uint256","name":"timestamp","type":"uint256","indexed":false}],"type":"event","name":"Attested","anonymous":false},{"inputs":[{"internalType":"bytes32","name":"reportHash","type":"bytes32"},{"internalType":"string","name":"endpoint","type":"string"},{"internalType":"uint256","name":"chainId","type":"uint256"},{"internalType":"uint256","name":"blockNumber","type":"uint256"}],"stateMutability":"nonpayable","type":"function","name":"anchor"},{"inputs":[{"internalType":"bytes32","name":"","type":"bytes32"}],"stateMutability":"view","type":"function","name":"anchored","outputs":[{"internalType":"bool","name":"","type":"bool"}]},{"inputs":[{"internalType":"bytes32","name":"","type":"bytes32"}],"stateMutability":"view","type":"function","name":"anchorerOf","outputs":[{"internalType":"address","name":"","type":"address"}]},{"inputs":[{"internalType":"bytes32","name":"reportHash","type":"bytes32"}],"stateMutability":"view","type":"function","name":"isAnchored","outputs":[{"internalType":"bool","name":"","type":"bool"}]}],"devdoc":{"kind":"dev","methods":{},"version":1},"userdoc":{"kind":"user","methods":{"anchor(bytes32,string,uint256,uint256)":{"notice":"Anchor a report hash. Reverts on an empty hash or a second anchor of the same hash."},"anchored(bytes32)":{"notice":"True once a report hash has been anchored."},"anchorerOf(bytes32)":{"notice":"The address that first anchored a report hash."},"isAnchored(bytes32)":{"notice":"Read-only check: has this report hash been anchored?"}},"version":1}},"settings":{"remappings":["forge-std/=lib/forge-std/src/"],"optimizer":{"enabled":true,"runs":200},"metadata":{"bytecodeHash":"ipfs"},"compilationTarget":{"contracts/NodeScopeAttestation.sol":"NodeScopeAttestation"},"evmVersion":